<dialog id="detail" aria-labelledby="detail-title">
  <div class="dialog-header">
    <h2 id="detail-title"></h2>
    <button id="close-detail" type="button">关闭 ×</button>
  </div>
  <div class="detail-content"></div>
</dialog>

<script>
"use strict";

/*
  全部 CSS、交互 JS 均内嵌，不依赖外部库、字体或 Google 资源。
  图片沿用现有作品集在线地址。
  如需国内公共 CDN，将下面 BASE 替换为你的 CDN 域名，
  并在 CDN 中保持相同图片目录结构。
*/
const BASE = "https://liuren-visual-studio.lusonchan.chatgpt.site";
const online = path => new URL(path, BASE).href;
const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

const categories = [
  "全部", "AIGC 作品", "电商作品", "网页设计作品", "网页动效作品",
  "品牌设计作品", "平面视觉作品", "字体设计作品", "其他作品"
];

const projects = [
  {
    title:"昆山杜克大学官网", category:"网页设计作品", year:"2025",
    cover:"/web-design/cover-1.png", description:"教育品牌官网 / 信息架构",
    slug:"duke-kunshan",
    images:["/web-design/cover-1.png","/web-design/duke-detail-1.webp","/web-design/duke-detail-2.webp"]
  },
  {
    title:"易念科技官网", category:"网页设计作品", year:"2025",
    cover:"/web-design/cover-2.png", description:"科技品牌官网 / 视觉系统",
    slug:"enian-tech",
    images:["/web-design/cover-2.png","/web-design/enian-detail-1.webp","/web-design/enian-detail-2.webp"]
  },
  {
    title:"万奇包装官网", category:"网页设计作品", year:"2024",
    cover:"/web-design/cover-3.png", description:"包装品牌官网 / 交互体验",
    slug:"wanqi-packaging",
    images:["/web-design/cover-3.png","/web-design/wanqi-detail-1.webp","/web-design/wanqi-detail-2.webp"]
  },
  {
    title:"西湖大学 NEM 实验室", category:"网页设计作品", year:"2024",
    cover:"/web-design/cover-4.png", description:"科研实验室官网 / 内容设计",
    slug:"nem-lab",
    images:["/web-design/cover-4.png","/web-design/nem-detail-1.webp","/web-design/nem-detail-2.webp"]
  },
  {
    title:"JOYEE 卫浴官网", category:"网页设计作品", year:"2024",
    cover:"/web-design/cover-5.png", description:"卫浴品牌官网 / 产品叙事",
    slug:"joyee-bathroom",
    images:Array.from({length:8},(_,i)=>`/joyee-assets-new/joyee-detail-${i+1}.jpg`)
  },
  {
    title:"Space 区块链官网", category:"网页设计作品", year:"2023",
    cover:"/space-detail/space-01.jpg", description:"数字科技官网 / 沉浸式视觉",
    slug:"space-blockchain",
    images:Array.from({length:9},(_,i)=>`/space-detail/space-${String(i+1).padStart(2,"0")}.jpg`)
  }
];

[
  "VR 产品网页动效","工业品牌网页动效","人物影像网页动效",
  "自然主题网页动效","饮品产品网页动效","户外主题网页动效",
  "太空主题网页动效","家居产品网页动效","创意教育网页动效"
].forEach((title,i)=>{
  const image=`/web-motion/motion-${String(i+1).padStart(2,"0")}.gif`;
  projects.push({
    title,category:"网页动效作品",year:"GIF",
    cover:image,description:"网页动效 / 循环演示",images:[image]
  });
});

for(let i=1;i<=84;i++){
  projects.push({
    title:`平面视觉 / ${String(i).padStart(2,"0")}`,
    category:"平面视觉作品",year:"",
    cover:`/graphic-visual/cover-${String(i).padStart(2,"0")}.webp`,
    description:"视觉构成 / 产品与品牌",
    images:[`/graphic-visual/visual-${String(i).padStart(2,"0")}.jpg`]
  });
}

[
  "丑书系列","手书系列","手写系列","手写系列2",
  "粤语系列","软件系列","造字系列"
].forEach((title,i)=>{
  const slug=`type-${String(i+1).padStart(2,"0")}`;
  projects.push({
    title,category:"字体设计作品",year:"TYPE",
    cover:`/type-design/${slug}/cover.webp`,
    description:`字体创作 / ${title}`,slug,
    images:[`/type-design/${slug}/cover.webp`]
  });
});

let selectedCategory="全部";
let currentPage=1;
let lastFocusedElement=null;
const PAGE_SIZE=30;

const filters=document.querySelector(".filters");
const grid=document.querySelector(".projects");
const pagination=document.querySelector(".pagination");
const empty=document.querySelector(".empty");
const dialog=document.querySelector("#detail");
const detailContent=document.querySelector(".detail-content");

document.querySelector("#project-count").textContent=
  `2021—2026 / ${projects.length} PROJECTS`;

categories.forEach(category=>{
  const button=document.createElement("button");
  button.type="button";
  button.textContent=category;
  button.setAttribute("aria-pressed",String(category===selectedCategory));
  button.addEventListener("click",()=>{
    selectedCategory=category;
    currentPage=1;
    renderProjects();
  });
  filters.append(button);
});

function makeImage(path,title){
  const img=document.createElement("img");
  img.src=online(path);
  img.alt=title;
  img.loading="lazy";
  img.decoding="async";
  img.addEventListener("error",()=>{
    img.hidden=true;
    const message=document.createElement("p");
    message.className="muted";
    message.textContent="图片暂不可用，请检查图片源访问权限。";
    img.after(message);
  },{once:true});
  return img;
}

function renderProjects(){
  filters.querySelectorAll("button").forEach(button=>{
    button.setAttribute("aria-pressed",String(button.textContent===selectedCategory));
  });

  const list=projects.filter(project=>
    selectedCategory==="全部"||project.category===selectedCategory
  );
  const pages=Math.ceil(list.length/PAGE_SIZE);
  currentPage=Math.max(1,Math.min(currentPage,pages||1));
  grid.replaceChildren();
  empty.hidden=list.length!==0;

  list.slice((currentPage-1)*PAGE_SIZE,currentPage*PAGE_SIZE).forEach(project=>{
    const article=document.createElement("article");
    article.className="project";
    if(project.category==="平面视觉作品")article.classList.add("graphic");
    if(project.category==="网页动效作品")article.classList.add("motion");

    const button=document.createElement("button");
    button.type="button";
    button.setAttribute("aria-label",`查看 ${project.title}`);
    const figure=document.createElement("figure");
    figure.append(makeImage(project.cover,project.title));

    const meta=document.createElement("div");
    meta.className="project-meta";
    const copy=document.createElement("div");
    const title=document.createElement("h3");
    const description=document.createElement("p");
    const year=document.createElement("span");
    title.textContent=project.title;
    description.textContent=project.description;
    year.textContent=project.year;
    copy.append(title,description);
    meta.append(copy,year);
    button.append(figure,meta);
    button.addEventListener("click",()=>openProject(project,button));
    article.append(button);
    grid.append(article);
  });

  pagination.replaceChildren();
  pagination.hidden=pages<=1;
  if(pages>1){
    function addPageButton(label,page,disabled=false){
      const button=document.createElement("button");
      button.type="button";
      button.textContent=label;
      button.disabled=disabled;
      if(typeof label==="number"&&page===currentPage){
        button.setAttribute("aria-current","page");
      }
      button.addEventListener("click",()=>{
        currentPage=page;
        renderProjects();
        document.querySelector("#work").scrollIntoView({
          behavior:reduceMotion.matches?"auto":"smooth"
        });
      });
      pagination.append(button);
    }
    addPageButton("上一页",currentPage-1,currentPage===1);
    for(let i=1;i<=pages;i++)addPageButton(i,i);
    addPageButton("下一页",currentPage+1,currentPage===pages);
  }
}

function openProject(project,button){
  lastFocusedElement=button;
  document.querySelector("#detail-title").textContent=project.title;
  detailContent.replaceChildren();

  const description=document.createElement("p");
  description.textContent=project.description;
  detailContent.append(description);

  /*
    字体完整详情仍位于原作品集在线页面。
    此链接无需外部 JS，即可查看同系列全部详情图片。
  */
  if(project.category==="字体设计作品"){
    const link=document.createElement("a");
    link.className="detail-link";
    link.href=online(`/work/${project.slug}/`);
    link.target="_blank";
    link.rel="noopener noreferrer";
    link.textContent="查看本系列完整详情";
    detailContent.append(link);
  }

  project.images.forEach((path,index)=>{
    detailContent.append(makeImage(path,`${project.title} · ${index+1}`));
  });

  dialog.showModal();
  dialog.scrollTop=0;
  document.body.classList.add("modal-open");
}

document.querySelector("#close-detail").addEventListener("click",()=>dialog.close());
dialog.addEventListener("close",()=>{
  document.body.classList.remove("modal-open");
  lastFocusedElement?.focus({preventScroll:true});
});
dialog.addEventListener("click",event=>{
  if(event.target!==dialog)return;
  const rect=dialog.getBoundingClientRect();
  if(event.clientX<rect.left||event.clientX>rect.right||
     event.clientY<rect.top||event.clientY>rect.bottom){
    dialog.close();
  }
});

const menu=document.querySelector(".menu-toggle");
const navigation=document.querySelector("#navigation");
menu.addEventListener("click",()=>{
  const open=navigation.classList.toggle("open");
  menu.setAttribute("aria-expanded",String(open));
  menu.textContent=open?"关闭":"菜单";
});
navigation.querySelectorAll("a").forEach(link=>{
  link.addEventListener("click",()=>{
    navigation.classList.remove("open");
    menu.setAttribute("aria-expanded","false");
    menu.textContent="菜单";
  });
});

let scrollQueued=false;
function updateProgress(){
  const max=document.documentElement.scrollHeight-innerHeight;
  document.querySelector(".progress").style.width=
    `${max>0?scrollY/max*100:0}%`;
  scrollQueued=false;
}
window.addEventListener("scroll",()=>{
  if(!scrollQueued){
    scrollQueued=true;
    requestAnimationFrame(updateProgress);
  }
},{passive:true});
window.addEventListener("resize",updateProgress);

const portrait=document.querySelector(".portrait");
portrait.addEventListener("pointermove",event=>{
  if(reduceMotion.matches||event.pointerType==="touch")return;
  const rect=portrait.getBoundingClientRect();
  const x=(event.clientX-rect.left)/rect.width-.5;
  const y=(event.clientY-rect.top)/rect.height-.5;
  portrait.style.setProperty("--rx",`${-y*12}deg`);
  portrait.style.setProperty("--ry",`${x*18}deg`);
});
portrait.addEventListener("pointerleave",()=>{
  portrait.style.setProperty("--rx","0deg");
  portrait.style.setProperty("--ry","0deg");
});

if("IntersectionObserver" in window&&!reduceMotion.matches){
  const observer=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
      if(!entry.isIntersecting)return;
      const element=entry.target;
      const target=Number(element.dataset.count);
      const start=performance.now();
      function animate(now){
        const progress=Math.min(1,(now-start)/1300);
        const eased=1-Math.pow(1-progress,3);
        element.textContent=String(Math.round(target*eased));
        if(progress<1)requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);
      observer.unobserve(element);
    });
  },{threshold:.6});
  document.querySelectorAll("[data-count]").forEach(element=>observer.observe(element));
}

renderProjects();
updateProgress();
</script>
</body>
</html>
