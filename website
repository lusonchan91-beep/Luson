<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="陈柳任的视觉策划、品牌设计、网页设计与 AIGC 作品集。">
<meta name="theme-color" content="#efefeb">
<title>陈柳任 · 视觉策划作品集</title>
<style>
:root{
  --bg:#efefeb;
  --ink:#191a18;
  --muted:#686b63;
  --line:#d1d4cb;
  --accent:#dafaaf;
  --radius:20px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:Arial,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size:16px;line-height:1.65;
}
button,a{-webkit-tap-highlight-color:transparent}
button,input{font:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
button:focus-visible,a:focus-visible{
  outline:3px solid #527535;outline-offset:5px;
}
button{color:inherit}
::selection{background:var(--accent);color:var(--ink)}
.container{width:min(1280px,calc(100% - 96px));margin:auto}
.section{padding:100px 0;border-top:1px solid var(--line)}
.label{
  display:flex;gap:24px;align-items:center;
  margin-bottom:40px;font-size:14px;letter-spacing:.08em;
}
.label span:first-child{color:var(--muted)}
.section-title{
  font-size:clamp(36px,5.5vw,76px);
  line-height:1.12;letter-spacing:-.045em;margin:0 0 44px;
}
.serif{font-family:Georgia,"Songti SC",serif;font-style:italic;font-weight:400}
.muted{color:var(--muted)}
.pill{
  display:inline-flex;align-items:center;justify-content:center;
  padding:13px 24px;border:1px solid var(--ink);border-radius:50px;
  background:transparent;transition:background .2s,transform .2s;
}
.pill:hover{background:var(--accent);transform:translateY(-2px)}
header{
  position:sticky;top:0;z-index:30;
  border-bottom:1px solid var(--line);
  background:rgba(239,239,235,.94);
  backdrop-filter:blur(14px);
}
.header-inner{
  min-height:78px;display:flex;align-items:center;
  justify-content:space-between;gap:24px;
}
.logo{font-size:26px;font-weight:900;letter-spacing:-.06em}
.logo sup{font-size:12px;margin-left:4px}
nav{display:flex;gap:32px;font-size:14px}
nav a{position:relative}
nav a::after{
  content:"";position:absolute;left:0;bottom:-6px;width:0;height:2px;
  background:var(--ink);transition:width .2s;
}
nav a:hover::after{width:100%}
.menu-toggle{display:none;border:0;background:none;padding:10px}
.progress{position:fixed;top:0;left:0;height:3px;width:0;background:#608640;z-index:50}
.hero{padding:34px 0 60px;min-height:calc(100svh - 78px)}
.hero-meta{
  display:flex;justify-content:space-between;gap:20px;
  color:var(--muted);font-size:13px;
}
.hero h1{
  font-size:clamp(95px,22vw,300px);
  line-height:1;letter-spacing:-.09em;margin:48px 0 35px;
}
.hero h1 sup{
  display:inline-block;vertical-align:top;
  font-size:clamp(22px,4vw,48px);letter-spacing:0;margin:18px 0 0 12px;
}
.hero-bottom{
  display:grid;grid-template-columns:1.15fr 1fr .85fr;
  gap:40px;align-items:center;
}
.hero h2{font-size:clamp(24px,2.8vw,38px);line-height:1.4;margin:12px 0 22px}
.eyebrow{font-size:13px;letter-spacing:.08em;color:var(--muted)}
.hero-art{height:270px;margin:0;display:grid;place-items:center}
.hero-art img{
  width:270px;height:270px;object-fit:contain;
  animation:float 6s ease-in-out infinite;
}
.hero-side p{color:var(--muted);margin-bottom:24px}
.hero-foot{
  display:flex;justify-content:space-between;gap:20px;
  margin-top:50px;color:var(--muted);font-size:13px;
}
@keyframes float{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-14px)}
}
.about-grid{display:grid;grid-template-columns:1.6fr .65fr;gap:70px;align-items:center}
.about h2{
  font-size:clamp(28px,3.7vw,50px);line-height:1.45;
  letter-spacing:-.035em;margin:0 0 25px;
}
.about h2 em{font-style:normal;background:var(--accent)}
.about-copy>p{max-width:690px;color:var(--muted);margin-bottom:28px}
.portrait{
  width:100%;max-width:260px;justify-self:center;
  perspective:800px;transform-style:preserve-3d;
}
.portrait img{
  width:100%;object-fit:contain;
  transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));
  transition:transform .18s ease-out;
}
.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin:70px 0 40px}
.fact{border-top:1px solid var(--ink);padding-top:24px}
.fact strong{display:block;font-size:clamp(34px,4vw,58px);letter-spacing:-.05em;line-height:1.2}
.fact span{display:block;margin-top:12px;color:var(--muted);font-size:14px}
.experience-scope{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.experience-scope h3{font-size:16px;margin:0 0 10px}
.experience-scope p{font-size:14px;color:var(--muted);margin:0}
.honors{
  margin-top:60px;padding:32px;
  background:var(--accent);border-radius:var(--radius);
  display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px;align-items:center;
}
.honors h3{font-size:23px;margin:0 0 10px}
.honors p{font-size:14px;margin:0}
.honor-number{font-size:66px;font-weight:800;line-height:1.1;letter-spacing:-.06em}
.honor-number small{font-size:16px;font-weight:400;letter-spacing:0;margin-left:8px}
.timeline{border-top:1px solid var(--ink)}
.timeline-item{
  display:grid;grid-template-columns:180px 1fr 190px;
  gap:30px;padding:30px 0;border-bottom:1px solid var(--line);
}
.timeline-item time{font-size:14px;color:var(--muted)}
.timeline-item h3{font-size:22px;margin:0 0 9px}
.timeline-item p{color:var(--muted);font-size:14px;margin:0;max-width:600px}
.timeline-item .role{font-size:14px;text-align:right}
.work-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:36px}
.work-heading .section-title{margin:0}
.filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:34px}
.filters button{
  border:1px solid var(--line);border-radius:40px;
  background:transparent;padding:10px 17px;font-size:14px;
}
.filters button:hover{border-color:var(--ink)}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.projects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:38px 25px}
.project button{
  width:100%;padding:0;background:none;border:0;text-align:left;
}
.project figure{margin:0;aspect-ratio:16/9;background:#ddd;overflow:hidden;border-radius:4px}
.project.graphic figure{aspect-ratio:4/3}
.project img{
  width:100%;height:100%;object-fit:cover;
  transition:transform .5s;
}
.project button:hover img{transform:scale(1.045)}
.project.motion img{transform:scale(1.36)}
.project.motion button:hover img{transform:scale(1.4)}
.project h3{font-size:18px;margin:17px 0 5px;line-height:1.4}
.project p{margin:0;color:var(--muted);font-size:13px}
.project-meta{display:flex;justify-content:space-between;gap:12px;align-items:start}
.project-meta>span{margin-top:18px;font-size:12px;color:var(--muted)}
.empty{padding:55px 0;text-align:center;color:var(--muted)}
.pagination{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin-top:45px}
.pagination button{
  border:1px solid var(--line);background:transparent;
  min-width:42px;padding:8px 12px;border-radius:8px;font-size:14px;
}
.pagination button[aria-current="page"]{background:var(--ink);color:var(--bg)}
.pagination button:disabled{opacity:.4;cursor:default}
.brands{display:flex;flex-wrap:wrap;gap:24px 45px;align-items:center}
.brands span{font-size:clamp(22px,3vw,40px);font-weight:800;letter-spacing:-.035em}
.statement{
  background:var(--ink);color:var(--bg);padding:90px 0;
}
.statement-inner{display:grid;grid-template-columns:1.3fr 1fr;align-items:center;gap:40px}
.statement p{font-size:clamp(42px,6.5vw,84px);line-height:1.18;margin:22px 0;letter-spacing:-.04em}
.statement .eyebrow{color:#b5b9ad}
.statement img{width:min(100%,370px);justify-self:center;object-fit:contain}
.contact h2{font-size:clamp(42px,7vw,90px);line-height:1.2;letter-spacing:-.04em;margin:0 0 36px}
.contact-mail{
  display:inline-block;font-size:clamp(20px,3vw,40px);
  border-bottom:1px solid var(--ink);overflow-wrap:anywhere;
}
.contact-bottom{display:flex;justify-content:space-between;gap:30px;margin-top:45px;color:var(--muted)}
footer{padding:26px 0;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}
.footer-inner{display:flex;justify-content:space-between;gap:20px}
dialog{
  width:min(1100px,calc(100% - 32px));max-height:90svh;
  border:0;padding:0;background:var(--bg);color:var(--ink);
  border-radius:12px;
}
dialog::backdrop{background:rgba(0,0,0,.78)}
.dialog-header{
  position:sticky;top:0;z-index:2;background:var(--bg);
  padding:18px 24px;border-bottom:1px solid var(--line);
  display:flex;justify-content:space-between;gap:20px;align-items:center;
}
.dialog-header h2{font-size:20px;margin:0}
.dialog-header button{
  border:1px solid var(--line);border-radius:40px;
  padding:7px 15px;background:transparent;white-space:nowrap;
}
.detail-content{padding:24px}
.detail-content img{width:100%;height:auto;margin-bottom:24px}
.detail-content p{color:var(--muted)}
.detail-link{display:inline-block;margin:4px 0 24px;text-decoration:underline}
body.modal-open{overflow:hidden}
[hidden]{display:none!important}
@media(max-width:1000px){
  .container{width:calc(100% - 48px)}
  .hero-bottom{grid-template-columns:1fr 1fr}
  .hero-side{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .hero-side p{margin:0}
  .projects{grid-template-columns:repeat(2,minmax(0,1fr))}
  .timeline-item{grid-template-columns:145px 1fr}
  .timeline-item .role{grid-column:2;text-align:left}
  .about-grid{gap:35px}
}
@media(max-width:640px){
  .container{width:calc(100% - 36px)}
  .section{padding:65px 0}
  .header-inner{min-height:66px}
  .menu-toggle{display:block}
  nav{
    display:none;position:absolute;top:66px;left:0;right:0;
    background:var(--bg);padding:24px;border-bottom:1px solid var(--line);
    flex-wrap:wrap;gap:24px;
  }
  nav.open{display:flex}
  .hero-meta{font-size:12px}
  .hero-meta span:nth-child(2){display:none}
  .hero h1{margin:55px 0 40px}
  .hero-bottom{gap:20px}
  .hero-art{height:180px}
  .hero-art img{width:180px;height:180px}
  .hero h2{font-size:21px}
  .hero-side{display:block}
  .hero-side .pill{margin-top:20px}
  .hero-foot{font-size:12px;margin-top:35px}
  .about-grid{grid-template-columns:1fr}
  .portrait{max-width:180px}
  .facts{gap:18px;margin:45px 0 30px}
  .fact strong{font-size:30px}
  .fact span{font-size:12px}
  .experience-scope{grid-template-columns:1fr;gap:22px}
  .honors{grid-template-columns:1fr 1fr;padding:25px;gap:25px}
  .honors>div:first-child{grid-column:1/-1}
  .honor-number{font-size:52px}
  .timeline-item{grid-template-columns:1fr;gap:10px;padding:25px 0}
  .timeline-item .role{grid-column:auto}
  .timeline-item h3{font-size:20px}
  .work-heading{display:block}
  .work-heading .eyebrow{display:block;margin-top:18px}
  .filters{gap:8px}
  .filters button{padding:8px 12px;font-size:13px}
  .projects{gap:28px 15px}
  .project h3{font-size:15px;margin-top:12px}
  .project p{font-size:12px}
  .project-meta>span{display:none}
  .brands{gap:20px 25px}
  .brands span{font-size:25px}
  .statement-inner{grid-template-columns:1fr}
  .statement img{width:230px}
  .contact-bottom,.footer-inner{flex-direction:column;gap:15px}
  .dialog-header{padding:15px}
  .dialog-header h2{font-size:16px}
  .detail-content{padding:15px}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
  .portrait img{transform:none}
}
</style>
</head>
<body>
<div class="progress" aria-hidden="true"></div>

<header>
  <div class="container header-inner">
    <a class="logo" href="#top" aria-label="LUSON 首页">LUSON<sup>©</sup></a>
    <nav id="navigation" aria-label="主导航">
      <a href="#about">关于</a>
